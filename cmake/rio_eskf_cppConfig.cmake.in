# cmake/rio_eskf_cppConfig.cmake.in
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/rio_eskf_cppTargets.cmake")

# Try to provide Eigen include dirs for consumers that rely on config packages.
# If the consumer already provides Eigen, that's fine.
if(@RIO_USE_SYSTEM_EIGEN@)
  find_package(Eigen3 QUIET)
endif()